{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "BrowserSettings": {
      "title": "BrowserSettings",
      "description": "Browser configuration and privacy settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "searchEngine": { "type": "string", "enum": ["google", "duckduckgo", "brave", "startpage"] },
        "vpnEnabled": { "type": "boolean" },
        "dnsProvider": { "type": "string", "enum": ["cloudflare", "google", "quad9"] },
        "blockCryptoMiners": { "type": "boolean" },
        "adblockEnabled": { "type": "boolean" },
        "blockTrackers": { "type": "boolean" }
      },
      "required": ["userId"]
    },
    "BrowserIndexItem": {
      "title": "BrowserIndexItem",
      "description": "Full-text indexed browser content, web pages, and documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "snippet": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["page", "bookmark", "history", "tile", "search"] },
        "domain": { "type": "string" },
        "favicon": { "type": "string" },
        "indexedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "url", "title"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Browser saved bookmark",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "url"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "Browser browsing history entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "visitedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "url"]
    },
    "SpeedDialTile": {
      "title": "SpeedDialTile",
      "description": "Speed dial dashboard tiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "domain": { "type": "string" },
        "bgGradient": { "type": "string" }
      },
      "required": ["id", "userId", "title", "url"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Gemini chatbot conversation message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "model": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "role", "content"]
    }
  },
  "firestore": {
    "/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "Bookmark" },
      "description": "Browser saved bookmarks in Firestore"
    },
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "BrowserSettings" },
      "description": "User browser configuration and privacy settings"
    },
    "/users/{userId}/indexItems/{itemId}": {
      "schema": { "$ref": "BrowserIndexItem" },
      "description": "Fully indexed browser contents for local search"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "Bookmark" },
      "description": "User bookmarks"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "HistoryItem" },
      "description": "Browsing history items"
    },
    "/users/{userId}/speedDialTiles/{tileId}": {
      "schema": { "$ref": "SpeedDialTile" },
      "description": "Custom speed dial tiles"
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": { "$ref": "ChatMessage" },
      "description": "Gemini AI chat history messages"
    }
  }
}
